# Modelo de variáveis. Copie `intern\.segredos\newai.env` para `.env.local`;
# nunca coloque valores reais aqui.

# Provedor do modelo: nvidia | openrouter | roteirizado
LLM_PROVEDOR=roteirizado
NVIDIA_API_KEY=
NVIDIA_MODELO=
OPENROUTER_API_KEY=
OPENROUTER_MODELO=
# Arquivo de roteiro usado quando LLM_PROVEDOR=roteirizado
LLM_ROTEIRO=src/contratos/exemplos/roteiros/cv-01.json

# Mercado (token da brapi só no cabeçalho Authorization: Bearer)
BRAPI_TOKEN=
# Opcional: sem chave a CoinGecko responde com limite menor
COINGECKO_API_KEY=

# Deploy público (P1)
CODIGO_ACESSO=
# local | publico
MODO=local

# nubank | neutra
NEXT_PUBLIC_MARCA=neutra
# 1 = frontend usa os exemplos do contrato no lugar das rotas /api/*
NEXT_PUBLIC_API_EXEMPLOS=0
